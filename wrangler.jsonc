{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "almusa-in",
  "type": "javascript",
  "compatibility_date": "2026-07-17",

  // Build configuration
  "build": {
    "command": "npm run build",
    "cwd": "./"
  },

  // Assets configuration for static files
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },

  // Site configuration
  "site": {
    "bucket": "dist"
  },

  // Observability
  "observability": {
    "enabled": true
  }
}